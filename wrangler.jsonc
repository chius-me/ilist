{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ilist",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/file/*", "/s/*"]
  },
  "routes": [
    {
      "pattern": "ilist.chius.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "admin",
    "SESSION_TTL_SECONDS": "604800"
  },
  "secrets": {
    "required": [
      "ADMIN_PASSWORD_HASH",
      "CREDENTIAL_MASTER_KEY",
      "SESSION_SECRET",
      "PUBLIC_ORIGIN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ilist-d1",
      "database_id": "a64f3be9-1470-4ad2-9cff-bc653d3ec2d0",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
