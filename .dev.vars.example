# Generate interactively with `npm run hash-password`; password argv is rejected.
# Rotate with `npx wrangler secret put ADMIN_PASSWORD_HASH`.
ADMIN_PASSWORD_HASH=pbkdf2-sha256:600000:replace_with_32_character_salt_hex:replace_with_64_character_hash_hex
CREDENTIAL_MASTER_KEY=replace-with-32-byte-base64-key
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=https://ilist.example.com

# Optional migration-only fallbacks. New OAuth mounts configure these in /admin/storages.
# MICROSOFT_CLIENT_ID=replace-with-legacy-application-client-id
# MICROSOFT_CLIENT_SECRET=replace-with-legacy-application-client-secret
# GOOGLE_CLIENT_ID=replace-with-legacy-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-legacy-google-oauth-client-secret
# DROPBOX_CLIENT_ID=replace-with-legacy-dropbox-app-key
# DROPBOX_CLIENT_SECRET=replace-with-legacy-dropbox-app-secret
