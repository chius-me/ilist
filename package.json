{
  "name": "ilist",
  "version": "0.2.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "deploy:d1": "wrangler d1 migrations apply DB --remote --env production",
    "deploy": "npm run deploy:d1 && npm run build && wrangler deploy --minify --env production",
    "types": "wrangler types src/worker/env.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check src tests scripts",
    "lint:fix": "biome check --write src tests scripts",
    "test": "npm run test:worker && npm run test:ui && npm run test:scripts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "check": "npm run typecheck && npm run build && npm run test",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "undici": "7.29.1"
  }
}
